# نمونه امکانات Nosrati ++ نسخه ۲
عدد سن = ۲۰
عدد پایه = ۱۰
عدد حاصل = سن × پایه
چاپ("حاصل ضرب:")
چاپ(حاصل)

اگر سن >= ۱۸ آنگاه
    چاپ("بزرگسال")
وگرنه
    چاپ("زیر ۱۸ سال")
پایان

چاپ("حلقه شمارشی:")
برای شمارنده از ۱ تا ۵ آنگاه
    چاپ(شمارنده)
پایان

آرایه<عدد> نمره‌ها = [۱۸، ۱۹، ۲۰]
چاپ(نمره‌ها[۰])

تابع توان۲(عدد ورودی) -> عدد آنگاه
    بازگردان ورودی × ورودی
پایان

چاپ(توان۲(۷))
